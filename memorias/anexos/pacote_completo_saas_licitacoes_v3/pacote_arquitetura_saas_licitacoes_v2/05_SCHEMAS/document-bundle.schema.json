{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.municipio.gov.br/schemas/document-bundle.schema.json",
  "title": "DocumentBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleId",
    "processId",
    "documents",
    "deterministicValidation",
    "renderArtifacts"
  ],
  "properties": {
    "bundleId": {
      "type": "string"
    },
    "processId": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "generated-document.schema.json"
      }
    },
    "deterministicValidation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "renderArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "documentId",
          "docxHash",
          "pdfHash",
          "renderStatus"
        ],
        "properties": {
          "documentId": {
            "type": "string"
          },
          "docxHash": {
            "type": "string"
          },
          "pdfHash": {
            "type": "string"
          },
          "renderStatus": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
