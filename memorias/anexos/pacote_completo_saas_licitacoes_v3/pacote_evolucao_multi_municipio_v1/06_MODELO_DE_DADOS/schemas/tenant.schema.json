{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tenant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "legalName",
    "status",
    "timezone"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "legalName": {
      "type": "string",
      "minLength": 2
    },
    "displayName": {
      "type": "string"
    },
    "taxId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "CONFIGURING",
        "VALIDATING",
        "ACTIVE",
        "SUSPENDED",
        "ARCHIVED"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
