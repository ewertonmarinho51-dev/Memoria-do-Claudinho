{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignatureSlot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "label",
    "eligibleRoleCodes",
    "minimum",
    "maximum",
    "secretariatScope",
    "required"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "eligibleRoleCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excludedRoleCodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "minimum": {
      "type": "integer",
      "minimum": 0
    },
    "maximum": {
      "type": "integer",
      "minimum": 1
    },
    "secretariatScope": {
      "enum": [
        "PROCESS_SECRETARIAT",
        "TENANT_ANY",
        "EXPLICIT"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "allowSubstitute": {
      "type": "boolean"
    },
    "displayOrder": {
      "type": "integer"
    }
  }
}
