{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secretariat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "name",
    "acronym",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "acronym": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "ARCHIVED"
      ]
    },
    "brandingProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
